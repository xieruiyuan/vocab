.badge-conv { display: inline-block; padding: 2px 6px; font-size: 0.72em; font-weight: 600; border-radius: 4px; margin-left: 6px; background: #f3e8ff; color: #7e22ce; vertical-align: middle; }
.phonetic { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: #0369a1; font-size: 0.95em; white-space: nowrap; }
