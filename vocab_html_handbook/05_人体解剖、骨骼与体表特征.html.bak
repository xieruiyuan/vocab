</style>

<script>
const audioPlayer = new Audio();
const imgOffsetMap = {};
let currentLang = localStorage.getItem("vocab_lang") || "en";

function setLanguage(lang) {
    currentLang = lang;
    localStorage.setItem("vocab_lang", lang);
    document.body.classList.toggle("lang-fr", lang === "fr");
    document.querySelectorAll(".lang-btn").forEach(btn => {
        btn.classList.toggle("active", btn.dataset.lang === lang);
    });
}

function speakNative(text, langCode) {
    if ("speechSynthesis" in window) {
        window.speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(text);
        u.lang = langCode;
        u.rate = 0.92;
        window.speechSynthesis.speak(u);
    }
}

function playWord(enWord, frAudioText) {
    if (currentLang === "fr") {
        const cleanFr = frAudioText.trim() || enWord;
        const encodedFr = encodeURIComponent(cleanFr);
        audioPlayer.src = `https://dict.youdao.com/dictvoice?audio=${encodedFr}&le=fr`;
        audioPlayer.play().catch(() => speakNative(cleanFr, "fr-FR"));
    } else {
        const encodedEn = encodeURIComponent(enWord.trim());
        audioPlayer.src = `https://dict.youdao.com/dictvoice?audio=${encodedEn}&type=2`;
        audioPlayer.play().catch(() => speakNative(enWord, "en-US"));
    }
}

function toggleAllSections(expand) {
    document.querySelectorAll("details.sub-section").forEach(d => d.open = expand);
}

function jumpToSection(secId) {
    const el = document.getElementById(secId);
    if (el) {
        el.open = true;
        el.scrollIntoView({ behavior: "smooth", block: "start" });
    }
}

async function swapImage(word, topicHint, imgId) {
    const imgEl = document.getElementById(imgId);
    imgOffsetMap[word] = (imgOffsetMap[word] || 0) + 1;
    const offset = imgOffsetMap[word];
    imgEl.style.opacity = "0.4";
    try {
        const q = encodeURIComponent(`${word} ${topicHint}`);
        const url = `https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=filetype:bitmap%20${q}&gsrnamespace=6&gsrlimit=6&prop=imageinfo&iiprop=url&iiurlwidth=280&format=json&origin=*`;
        const resp = await fetch(url);
        const data = await resp.json();
        const pages = Object.values(data.query?.pages || {});
        if (pages.length > 0) {
            const pick = pages[offset % pages.length];
            const newUrl = pick.imageinfo?.[0]?.thumburl;
            if (newUrl) {
                imgEl.src = newUrl;
                localStorage.setItem("custom_img_" + word, newUrl);
            }
        }
    } catch (e) { console.error(e); }
    imgEl.style.opacity = "1";
}

window.addEventListener("DOMContentLoaded", () => {
    setLanguage(currentLang);
    document.querySelectorAll("img[data-word]").forEach(img => {
        const saved = localStorage.getItem("custom_img_" + img.dataset.word);
        if (saved) img.src = saved;
    });
});
</script>
