<tr><td class='word'><span class='word-en-box'>descending colon<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>le côlon descendant<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 descending colon</span></span></td><td class='phonetic'><span class='ph-en-text'>/diˈsendiŋ ˈkəulən/</span><span class='ph-fr-text'>/kolɔ̃ desɑ̃dɑ̃/</span> <button class='audio-btn' onclick="playWord('descending colon', 'le côlon descendant')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>降结肠</td><td class='def-en'>the part of the large intestine that descends from the transverse colon to the sigmoid colon</td><td>3.25</td><td><div class='img-box'><img id='img_261' data-word="descending colon" src='images/descending_colon.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('descending colon', 'human', 'img_261')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>urinary organ<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>l'appareil urinaire<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 urinary organ</span></span></td><td class='phonetic'><span class='ph-en-text'>/ˈjʊərəˌneri: ˈɔ:ɡən/</span><span class='ph-fr-text'>/apaʁɛj yʁinɛʁ/</span> <button class='audio-btn' onclick="playWord('urinary organ', 'l\'appareil urinaire')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>泌尿器</td><td class='def-en'>an organ that separates waste substances from the blood and discharges them</td><td>3.25</td><td><div class='img-box'><img id='img_262' data-word="urinary organ" src='images/urinary_organ.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('urinary organ', 'human', 'img_262')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
