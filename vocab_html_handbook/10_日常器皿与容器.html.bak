</style>
<style>
.audio-btn {
    display: inline-flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer; font-size: 1.05em;
    padding: 2px 6px; margin-left: 5px; color: #64748b; border-radius: 4px;
    transition: all 0.15s; vertical-align: middle;
}
.audio-btn:hover { color: #2563eb; background: #e2e8f0; transform: scale(1.15); }
.img-box { position: relative; width: 115px; height: 88px; }
.img-box img { width: 115px; height: 88px; border-radius: 6px; object-fit: cover; border: 1px solid #cbd5e1; background: #fff; display: block; }
.swap-btn {
    position: absolute; bottom: 4px; right: 4px; background: rgba(15,23,42,0.75);
    color: #fff; border: none; border-radius: 4px; font-size: 11px; padding: 2px 5px;
    cursor: pointer; opacity: 0; transition: opacity 0.2s;
}
.img-box:hover .swap-btn { opacity: 1; }
.swap-btn:hover { background: #2563eb; }
</style>
<script>
const audioPlayer = new Audio();
const imgOffsetMap = {};

function playWord(word) {
    const cleanWord = encodeURIComponent(word.trim());
    audioPlayer.src = `https://dict.youdao.com/dictvoice?audio=${cleanWord}&type=2`;
    audioPlayer.play().catch(() => {
        if ("speechSynthesis" in window) {
            window.speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance(word);
            u.lang = "en-US"; u.rate = 0.9;
            window.speechSynthesis.speak(u);
        }
    });
}

// 网页端直接调用 Wikimedia Commons 实时切换下一张图片（并记住你的选择）
async function swapImage(word, topicHint, imgId) {
    const imgEl = document.getElementById(imgId);
    imgOffsetMap[word] = (imgOffsetMap[word] || 0) + 1;
    const offset = imgOffsetMap[word];
    imgEl.style.opacity = "0.4";
    try {
        const q = encodeURIComponent(`${word} ${topicHint}`);
        const url = `https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=filetype:bitmap%20${q}&gsrnamespace=6&gsrlimit=6&prop=imageinfo&iiprop=url&iiurlwidth=280&format=json&origin=*`;
        const resp = await fetch(url);
        const data = await resp.json();
        const pages = Object.values(data.query?.pages || {});
        if (pages.length > 0) {
            const pick = pages[offset % pages.length];
            const newUrl = pick.imageinfo?.[0]?.thumburl;
            if (newUrl) {
                imgEl.src = newUrl;
                localStorage.setItem("custom_img_" + word, newUrl);
            }
        }
    } catch (e) { console.error(e); }
    imgEl.style.opacity = "1";
}

window.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("img[data-word]").forEach(img => {
        const saved = localStorage.getItem("custom_img_" + img.dataset.word);
        if (saved) img.src = saved;
    });
});
</script>
</head><body>
