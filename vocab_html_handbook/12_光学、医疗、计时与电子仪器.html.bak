.word-fr-box { display: none; }
.en-sub-hint { display: block; font-size: 0.75em; font-weight: 500; color: #64748b; margin-top: 3px; }
body.lang-fr .word-en-box { display: none; }
body.lang-fr .word-fr-box { display: inline; color: #0f172a; }

/* 法语阴阳性与复数徽章样式 */
.fr-pos-m { display: inline-block; padding: 1px 6px; font-size: 0.72em; font-weight: 700; border-radius: 4px; margin-left: 6px; background: #dbeafe; color: #1e40af; vertical-align: middle; }
.fr-pos-f { display: inline-block; padding: 1px 6px; font-size: 0.72em; font-weight: 700; border-radius: 4px; margin-left: 6px; background: #fce7f3; color: #be185d; vertical-align: middle; }
.fr-pos-mf { display: inline-block; padding: 1px 6px; font-size: 0.72em; font-weight: 700; border-radius: 4px; margin-left: 6px; background: #f3e8ff; color: #6b21a8; vertical-align: middle; }
.fr-pl-badge { display: inline-block; padding: 1px 6px; font-size: 0.71em; font-weight: 600; border-radius: 4px; margin-left: 5px; background: #fef3c7; color: #b45309; border: 1px solid #fde68a; vertical-align: middle; }

.ph-fr-text { display: none; color: #b91c1c; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
body.lang-fr .ph-en-text { display: none; }
