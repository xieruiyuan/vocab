    font-size: 1.12em; font-weight: 700; transition: background 0.2s;
}
body.lang-fr summary.sub-header { background: linear-gradient(90deg, #7f1d1d, #dc2626); }
summary.sub-header::-webkit-details-marker { display: none; }
.arrow-icon { display: inline-block; transition: transform 0.2s ease; margin-right: 10px; font-size: 0.9em; }
details[open] > summary.sub-header .arrow-icon { transform: rotate(90deg); }
