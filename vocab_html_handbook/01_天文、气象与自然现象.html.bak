.sub-pill { text-decoration: none; padding: 5px 11px; border-radius: 99px; font-size: 0.85em; font-weight: 600; color: #1e40af; background: #fff; border: 1px solid #93c5fd; transition: all 0.15s; cursor: pointer; }
.sub-pill:hover { background: #2563eb; color: #fff; border-color: #2563eb; }
.ctrl-btn { padding: 5px 12px; border-radius: 6px; font-size: 0.85em; font-weight: 600; cursor: pointer; border: 1px solid #1e3a8a; background: #1e3a8a; color: #fff; transition: opacity 0.15s; }
.ctrl-btn.secondary { background: #fff; color: #1e3a8a; }
