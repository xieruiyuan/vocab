<details class='sub-section' id='sub_0' open><summary class='sub-header'><span><span class='arrow-icon'>▶</span>01_天体、星系与宇宙结构 (Celestial Bodies & Space)</span><span class='sub-meta'>共 30 词 • 点击展开 / 收起</span></summary><table><tr><th width='22%'>单词 (英 / 法性数完整形态)</th><th width='14%'>音标 (英 / 法 IPA)</th><th width='22%'>中文释义</th><th width='24%'>英文定义 (WordNet)</th><th width='6%'>词频</th><th width='12%'>实物配图</th></tr>
<tr><td class='word'><span class='word-en-box'>galaxy</span><span class='word-fr-box'>la galaxie<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 galaxy</span></span></td><td class='phonetic'><span class='ph-en-text'>/'gælәksi/</span><span class='ph-fr-text'>/galaksi/</span> <button class='audio-btn' onclick="playWord('galaxy', 'la galaxie')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 银河, 星系, 一群(显赫的人物)</td><td class='def-en'>a splendid assemblage (especially of famous people)</td><td>4.28</td><td><div class='img-box'><img id='img_1' data-word="galaxy" src='images/galaxy.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('galaxy', 'astronomy', 'img_1')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>nova</span><span class='word-fr-box'>le nova<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 nova</span></span></td><td class='phonetic'><span class='ph-en-text'>/'nәuvә/</span><span class='ph-fr-text'>/nɔva/</span> <button class='audio-btn' onclick="playWord('nova', 'le nova')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 新星</td><td class='def-en'>a star that ejects some of its material in the form of a cloud and become more luminous in the process</td><td>3.92</td><td><div class='img-box'><img id='img_2' data-word="nova" src='images/nova.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('nova', 'astronomy', 'img_2')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>heavenly body<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>l'astre<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 heavenly body</span></span></td><td class='phonetic'><span class='ph-en-text'>/ˈhevənli: ˈbɔdi/</span><span class='ph-fr-text'>/astʁ/</span> <button class='audio-btn' onclick="playWord('heavenly body', 'l\'astre')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 天体</td><td class='def-en'>natural objects visible in the sky</td><td>3.79</td><td><div class='img-box'><img id='img_3' data-word="heavenly body" src='images/heavenly_body.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('heavenly body', 'astronomy', 'img_3')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>inferior planet<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>la planète<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 inferior planet</span></span></td><td class='phonetic'><span class='ph-en-text'>/inˈfiəriə ˈplænit/</span><span class='ph-fr-text'>/planɛt/</span> <button class='audio-btn' onclick="playWord('inferior planet', 'la planète')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>内行星</td><td class='def-en'>any of the planets whose orbit lies inside the earth's orbit</td><td>3.76</td><td><div class='img-box'><img id='img_4' data-word="inferior planet" src='images/inferior_planet.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('inferior planet', 'astronomy', 'img_4')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>red dwarf<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>la naine rouge<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 red dwarf</span></span></td><td class='phonetic'><span class='ph-en-text'>/red dwɔ:f/</span><span class='ph-fr-text'>/nɛn ʁuʒ/</span> <button class='audio-btn' onclick="playWord('red dwarf', 'la naine rouge')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>红矮星</td><td class='def-en'>a small, old, relatively cool star; approximately 100 times the mass of Jupiter</td><td>3.74</td><td><div class='img-box'><img id='img_5' data-word="red dwarf" src='images/red_dwarf.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('red dwarf', 'astronomy', 'img_5')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>white dwarf<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>la naine blanche<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 white dwarf</span></span></td><td class='phonetic'><span class='ph-en-text'>/hwait dwɔ:f/</span><span class='ph-fr-text'>/nɛn blɑ̃ʃ/</span> <button class='audio-btn' onclick="playWord('white dwarf', 'la naine blanche')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 白矮星</td><td class='def-en'>a faint star of enormous density</td><td>3.74</td><td><div class='img-box'><img id='img_6' data-word="white dwarf" src='images/white_dwarf.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('white dwarf', 'astronomy', 'img_6')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>comet</span><span class='word-fr-box'>la comète<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 comet</span></span></td><td class='phonetic'><span class='ph-en-text'>/'kɒmit/</span><span class='ph-fr-text'>/kɔmɛt/</span> <button class='audio-btn' onclick="playWord('comet', 'la comète')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 彗星</td><td class='def-en'>(astronomy) a relatively small extraterrestrial body consisting of a frozen mass that travels around the sun in a highly elliptical orbit</td><td>3.64</td><td><div class='img-box'><img id='img_7' data-word="comet" src='images/comet.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('comet', 'astronomy', 'img_7')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>flare star<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>l'étoile éruptive<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 flare star</span></span></td><td class='phonetic'><span class='ph-en-text'>/flɛə stɑ:/</span><span class='ph-fr-text'>/etwal eʁyptiv/</span> <button class='audio-btn' onclick="playWord('flare star', 'l\'étoile éruptive')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>耀星</td><td class='def-en'>a red dwarf star in which luminosity can change several magnitudes in a few minutes</td><td>3.63</td><td><div class='img-box'><img id='img_8' data-word="flare star" src='images/flare_star.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('flare star', 'astronomy', 'img_8')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>asteroid</span><span class='word-fr-box'>l'astéroïde<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 asteroid</span></span></td><td class='phonetic'><span class='ph-en-text'>/'æstәrɒid/</span><span class='ph-fr-text'>/asteʁɔid/</span> <button class='audio-btn' onclick="playWord('asteroid', 'l\'astéroïde')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 小行星, 海盘车</td><td class='def-en'>any of numerous small celestial bodies composed of rock and metal that move around the sun (mainly between the orbits of Mars and Jupiter)</td><td>3.56</td><td><div class='img-box'><img id='img_9' data-word="asteroid" src='images/asteroid.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('asteroid', 'astronomy', 'img_9')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>celestial body<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>l'astre<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 celestial body</span></span></td><td class='phonetic'><span class='ph-en-text'>/si'lestjәl 'bɒdi/</span><span class='ph-fr-text'>/astʁ/</span> <button class='audio-btn' onclick="playWord('celestial body', 'l\'astre')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>天体；[法] 天体</td><td class='def-en'>natural objects visible in the sky</td><td>3.56</td><td><div class='img-box'><img id='img_10' data-word="celestial body" src='images/celestial_body.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('celestial body', 'astronomy', 'img_10')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>meteor</span><span class='word-fr-box'>la météore<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 meteor</span></span></td><td class='phonetic'><span class='ph-en-text'>/'mi:tiә/</span><span class='ph-fr-text'>/meteɔʁ/</span> <button class='audio-btn' onclick="playWord('meteor', 'la météore')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 流星, 大气现象</td><td class='def-en'>(astronomy) any of the small solid extraterrestrial bodies that hits the earth's atmosphere</td><td>3.55</td><td><div class='img-box'><img id='img_11' data-word="meteor" src='images/meteor.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('meteor', 'astronomy', 'img_11')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>terrestrial planet<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>la planète tellurique<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 terrestrial planet</span></span></td><td class='phonetic'><span class='ph-en-text'>/təˈrestri:əl ˈplænit/</span><span class='ph-fr-text'>/planɛt telyʁik/</span> <button class='audio-btn' onclick="playWord('terrestrial planet', 'la planète tellurique')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>类地行星</td><td class='def-en'>a planet having a compact rocky surface like the Earth's; the four innermost planets in the solar system</td><td>3.45</td><td><div class='img-box'><img id='img_12' data-word="terrestrial planet" src='images/terrestrial_planet.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('terrestrial planet', 'astronomy', 'img_12')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>neutron star<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>l'étoile à neutrons<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 neutron star</span></span></td><td class='phonetic'><span class='ph-en-text'>/ˈnu:ˌtrɔn stɑ:/</span><span class='ph-fr-text'>/etwal a nøtʁɔ̃/</span> <button class='audio-btn' onclick="playWord('neutron star', 'l\'étoile à neutrons')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 中子星</td><td class='def-en'>a star that has collapsed under its own gravity; it is composed of neutrons</td><td>3.43</td><td><div class='img-box'><img id='img_13' data-word="neutron star" src='images/neutron_star.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('neutron star', 'astronomy', 'img_13')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
