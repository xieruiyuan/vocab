<tr><td class='word'><span class='word-en-box'>bean</span><span class='word-fr-box'>la féverole<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 bean</span></span></td><td class='phonetic'><span class='ph-en-text'>/bi:n/</span><span class='ph-fr-text'>/feveʁol/</span> <button class='audio-btn' onclick="playWord('bean', 'la féverole')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 豆子</td><td class='def-en'>any of various edible seeds of plants of the family Leguminosae used for food</td><td>3.98</td><td><div class='img-box'><img id='img_1' data-word="bean" src='images/bean.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('bean', 'food', 'img_1')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>vegetable</span><span class='word-fr-box'>le légume<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 vegetable</span></span></td><td class='phonetic'><span class='ph-en-text'>/'vedʒәtәbl/</span><span class='ph-fr-text'>/legym/</span> <button class='audio-btn' onclick="playWord('vegetable', 'le légume')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 蔬菜, 植物, 无精打采之人</td><td class='def-en'>edible seeds or roots or stems or leaves or bulbs or tubers or nonsweet fruits of any of numerous herbaceous plant</td><td>3.94</td><td><div class='img-box'><img id='img_2' data-word="vegetable" src='images/vegetable.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('vegetable', 'food', 'img_2')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
