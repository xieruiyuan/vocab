<tr><td class='word'><span class='word-en-box'>worm</span><span class='word-fr-box'>le ver<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 worm</span></span></td><td class='phonetic'><span class='ph-en-text'>/wә:m/</span><span class='ph-fr-text'>/vɛʁ/</span> <button class='audio-btn' onclick="playWord('worm', 'le ver')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 虫, 蠕虫, 小人物, 螺纹, 蜗杆</td><td class='def-en'>any of numerous relatively small elongated soft-bodied animals especially of the phyla Annelida and Chaetognatha and Nematoda and Nemertea and Platyhelminthes; also many insect larvae</td><td>3.77</td><td><div class='img-box'><img id='img_571' data-word="worm" src='images/worm.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('worm', 'animals', 'img_571')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>crab</span><span class='word-fr-box'>la crabe<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 crab</span></span></td><td class='phonetic'><span class='ph-en-text'>/kræb/</span><span class='ph-fr-text'>/kʁab/</span> <button class='audio-btn' onclick="playWord('crab', 'la crabe')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 螃蟹, 偏航, 脾气乖戾的人, 沙果</td><td class='def-en'>decapod having eyes on short stalks and a broad flattened carapace with a small abdomen folded under the thorax and pincers</td><td>3.76</td><td><div class='img-box'><img id='img_572' data-word="crab" src='images/crab.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('crab', 'animals', 'img_572')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>red worm<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>le ver de terre<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 red worm</span></span></td><td class='phonetic'><span class='ph-en-text'>/red wə:m/</span><span class='ph-fr-text'>/vɛʁ də tɛʁ/</span> <button class='audio-btn' onclick="playWord('red worm', 'le ver de terre')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>活赤虫</td><td class='def-en'>terrestrial worm that burrows into and helps aerate soil; often surfaces when the ground is cool or wet; used as bait by anglers</td><td>3.76</td><td><div class='img-box'><img id='img_573' data-word="red worm" src='images/red_worm.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('red worm', 'animals', 'img_573')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>fishing worm<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>le ver de terre<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 fishing worm</span></span></td><td class='phonetic'><span class='ph-en-text'>/ˈfɪʃɪŋ wə:m/</span><span class='ph-fr-text'>/vɛʁ də tɛʁ/</span> <button class='audio-btn' onclick="playWord('fishing worm', 'le ver de terre')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>[体]鱼虫</td><td class='def-en'>terrestrial worm that burrows into and helps aerate soil; often surfaces when the ground is cool or wet; used as bait by anglers</td><td>3.69</td><td><div class='img-box'><img id='img_574' data-word="fishing worm" src='images/fishing_worm.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('fishing worm', 'animals', 'img_574')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
