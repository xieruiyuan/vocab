<tr><td class='word'><span class='word-en-box'>night lizard<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>la xantusiidae<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 night lizard</span></span></td><td class='phonetic'><span class='ph-en-text'>/nait 'lizәd/</span><span class='ph-fr-text'>/xɑ̃tyziida/</span> <button class='audio-btn' onclick="playWord('night lizard', 'la xantusiidae')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>[动物]夜蜥科（Xantusiidae）蜥蜴(产于北美洲)</td><td class='def-en'>small secretive nocturnal lizard of southwestern North America and Cuba; bear live young</td><td>3.63</td><td><div class='img-box'><img id='img_343' data-word="night lizard" src='images/night_lizard.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('night lizard', 'animals', 'img_343')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>flying lizard<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>le dragon<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 flying lizard</span></span></td><td class='phonetic'><span class='ph-en-text'>/'flaiiŋ 'lizәd/</span><span class='ph-fr-text'>/dʁagɔ̃/</span> <button class='audio-btn' onclick="playWord('flying lizard', 'le dragon')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>【动物】飞蜥,飞龙(= flying dragon)</td><td class='def-en'>any of several small tropical Asian lizards capable of gliding by spreading winglike membranes on each side of the body</td><td>3.6</td><td><div class='img-box'><img id='img_344' data-word="flying lizard" src='images/flying_lizard.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('flying lizard', 'animals', 'img_344')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>glass lizard<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>l'ophisaurus<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 glass lizard</span></span></td><td class='phonetic'><span class='ph-en-text'>/ɡlɑ:s ˈlɪzəd/</span><span class='ph-fr-text'>/ofizoʁy/</span> <button class='audio-btn' onclick="playWord('glass lizard', 'l\'ophisaurus')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>[动物]脆蛇蜥</td><td class='def-en'>snakelike lizard of Europe and Asia and North America with vestigial hind limbs and the ability to regenerate its long fragile tail</td><td>3.6</td><td><div class='img-box'><img id='img_345' data-word="glass lizard" src='images/glass_lizard.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('glass lizard', 'animals', 'img_345')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>monitor lizard<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>le moniteur<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 monitor lizard</span></span></td><td class='phonetic'><span class='ph-en-text'>/'mɒnitә 'lizәd/</span><span class='ph-fr-text'>/mɔnitœʁ/</span> <button class='audio-btn' onclick="playWord('monitor lizard', 'le moniteur')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>巨蜥</td><td class='def-en'>any of various large tropical carnivorous lizards of Africa and Asia and Australia; fabled to warn of crocodiles</td><td>3.56</td><td><div class='img-box'><img id='img_346' data-word="monitor lizard" src='images/monitor_lizard.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('monitor lizard', 'animals', 'img_346')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>horny frog<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>le batracien<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 horny frog</span></span></td><td class='phonetic'><span class='ph-en-text'>/'hɒ:ni frɒg/</span><span class='ph-fr-text'>/batʁasjɛ̃/</span> <button class='audio-btn' onclick="playWord('horny frog', 'le batracien')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>un. 角质蹄叉</td><td class='def-en'>insectivorous lizard with hornlike spines on the head and spiny scales on the body; of western North America</td><td>3.54</td><td><div class='img-box'><img id='img_347' data-word="horny frog" src='images/horny_frog.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('horny frog', 'animals', 'img_347')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>fence lizard<span class='badge-comp'>复合词</span></span><span class='word-fr-box'>le lézard<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 fence lizard</span></span></td><td class='phonetic'><span class='ph-en-text'>/fens 'lizәd/</span><span class='ph-fr-text'>/lezaʁ/</span> <button class='audio-btn' onclick="playWord('fence lizard', 'le lézard')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>un. 刺蜥；美洲石龙子</td><td class='def-en'>spiny lizard often seen basking on fences in the United States and northern Mexico</td><td>3.53</td><td><div class='img-box'><img id='img_348' data-word="fence lizard" src='images/fence_lizard.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('fence lizard', 'animals', 'img_348')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
