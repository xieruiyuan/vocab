<tr><td class='word'><span class='word-en-box'>marsupial</span><span class='word-fr-box'>le marsupial<span class='fr-pos-m'>n.m.</span><span class='fr-pl-badge' title='不规则复数形式'>pl. marsupiaux</span><span class='en-sub-hint'>🇬🇧 marsupial</span></span></td><td class='phonetic'><span class='ph-en-text'>/mɑ:'sju:piәl/</span><span class='ph-fr-text'>/maʁsypjal/</span> <button class='audio-btn' onclick="playWord('marsupial', 'le marsupial')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 有袋类动物</td><td class='def-en'>mammals of which the females have a pouch (the marsupium) containing the teats where the young are fed and carried</td><td>2.41</td><td><div class='img-box'><img id='img_221' data-word="marsupial" src='images/marsupial.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('marsupial', 'animals', 'img_221')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
<tr><td class='word'><span class='word-en-box'>marmot</span><span class='word-fr-box'>le marmot<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 marmot</span></span></td><td class='phonetic'><span class='ph-en-text'>/'mɑ:mәt/</span><span class='ph-fr-text'>/maʁmo/</span> <button class='audio-btn' onclick="playWord('marmot', 'le marmot')" title='播放当前语言发音 (法语连读冠词)'>🔊</button></td><td>n. 土拨鼠</td><td class='def-en'>stocky coarse-furred burrowing rodent with a short bushy tail found throughout the northern hemisphere; hibernates in winter</td><td>2.4</td><td><div class='img-box'><img id='img_222' data-word="marmot" src='images/marmot.jpg' loading='lazy'/><button class='swap-btn' onclick="swapImage('marmot', 'animals', 'img_222')" title='点击切换下一张图'>🔄 换图</button></div></td></tr>
