.meta { font-size: 0.85em; color: #64748b; line-height: 1.55; }
</style>
<style>
:root {
    --primary: #0d9488;
    --primary-light: #f0fdfa;
    --primary-border: #ccfbf1;
}
body.pt-mode {
    --primary: #4f46e5;
    --primary-light: #eef2ff;
    --primary-border: #e0e7ff;
}

/* 顶部模式切换栏 */
.mode-switch-bar {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    background: #0f172a; padding: 10px 18px; border-radius: 12px; margin-bottom: 12px;
    color: #fff; flex-wrap: wrap; box-shadow: 0 2px 8px rgba(15,23,42,0.08);
}
.mode-group { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.mode-btn {
    text-decoration: none; padding: 7px 14px; border-radius: 8px; font-size: 0.86em;
    font-weight: 600; color: #cbd5e1; background: rgba(255,255,255,0.08); transition: all 0.15s;
}
.mode-btn:hover { background: rgba(255,255,255,0.16); color: #fff; }
.mode-btn.active-sc { background: #0d9488; color: #fff; }
.mode-btn.active-pt { background: #4f46e5; color: #fff; }

/* 极简 1 行式顶部导航栏 */
.nav-bar {
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
    background: rgba(255,255,255,0.94); backdrop-filter: blur(10px);
    padding: 10px 14px; border-radius: 12px; box-shadow: 0 2px 8px rgba(15,23,42,0.04);
    margin-bottom: 18px; position: sticky; top: 8px; z-index: 30; border: 1px solid #e2e8f0;
}
.nav-link {
    text-decoration: none; padding: 5px 11px; border-radius: 7px; font-size: 0.82em;
    font-weight: 600; color: #475569; background: #f8fafc; border: 1px solid #e2e8f0;
    transition: all 0.15s; white-space: nowrap;
}
.nav-link:hover { background: #f1f5f9; color: #0f172a; border-color: #cbd5e1; }
.nav-link.active {
    background: var(--primary); color: #fff; border-color: var(--primary);
}
.nav-cnt { font-size: 0.84em; opacity: 0.8; font-weight: 500; margin-left: 2px; }

/* 清爽页面主标题区 */
.page-hero {
    background: #fff; padding: 20px 24px; border-radius: 12px; border: 1px solid #e2e8f0;
    margin-bottom: 14px; display: flex; justify-content: space-between; align-items: flex-end;
    flex-wrap: wrap; gap: 12px;
}
.hero-title { font-size: 1.5em; font-weight: 800; color: #0f172a; margin: 0 0 6px 0; letter-spacing: -0.01em; }
.hero-sub { font-size: 0.92em; color: #64748b; margin: 0; font-weight: 500; }
.hero-badge {
    display: inline-block; background: var(--primary-light); color: var(--primary);
    border: 1px solid var(--primary-border); font-size: 0.78em; font-weight: 700;
    padding: 3px 10px; border-radius: 6px; margin-left: 10px; vertical-align: middle;
}

/* 结构化工具栏：分段筛选器 + 实时搜索 + 章节直达 */
.toolbar-card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px;
    margin-bottom: 20px; display: flex; flex-direction: column; gap: 12px;
}
.toolbar-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
.filter-group { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.filter-label { font-size: 0.78em; font-weight: 700; color: #64748b; margin-right: 4px; }

.seg-bar { display: inline-flex; background: #f1f5f9; padding: 3px; border-radius: 8px; gap: 2px; flex-wrap: wrap; }
.seg-btn {
    border: none; background: transparent; padding: 5px 11px; border-radius: 6px;
    font-size: 0.82em; font-weight: 600; color: #475569; cursor: pointer; transition: all 0.15s;
}
.seg-btn:hover { color: #0f172a; }
.seg-btn.active { background: #fff; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.08); font-weight: 700; }

.search-box {
    padding: 6px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.84em;
    width: 220px; outline: none; transition: border 0.15s; background: #f8fafc;
}
.search-box:focus { border-color: var(--primary); background: #fff; }

.anchor-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
    padding-top: 10px; border-top: 1px dashed #e2e8f0;
}
.sub-pill {
    text-decoration: none; padding: 4px 11px; border-radius: 6px; font-size: 0.82em;
    font-weight: 600; color: #334155; background: #f8fafc; border: 1px solid #cbd5e1;
    cursor: pointer; transition: all 0.15s;
}
.sub-pill:hover { background: var(--primary); color: #fff; border-color: var(--primary); }

/* 折叠章节与低饱和度深色表头 */
details.sub-section {
    margin-bottom: 18px; background: #fff; border-radius: 12px;
    box-shadow: 0 1px 3px rgba(15,23,42,0.04); border: 1px solid #e2e8f0; overflow: hidden;
}
summary.sub-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 13px 20px; background: #1e293b; color: #f8fafc;
    cursor: pointer; user-select: none; list-style: none;
    font-size: 1.02em; font-weight: 700; transition: background 0.15s;
}
body.pt-mode summary.sub-header { background: #1e1b4b; }
summary.sub-header:hover { background: #334155; }
body.pt-mode summary.sub-header:hover { background: #312e81; }
summary.sub-header::-webkit-details-marker { display: none; }
.arrow-icon { display: inline-block; transition: transform 0.2s ease; margin-right: 10px; font-size: 0.82em; color: #94a3b8; }
details[open] > summary.sub-header .arrow-icon { transform: rotate(90deg); color: #38bdf8; }
.sub-meta { font-size: 0.8em; font-weight: 600; color: #e2e8f0; background: rgba(255,255,255,0.12); padding: 3px 10px; border-radius: 99px; }


/* EPE 原著章节精要折叠抽屉（保持首屏简洁，展开即读原书精髓） */
details.epe-book-drawer {
    background: #fff; border: 1px solid #c7d2fe; border-radius: 12px;
    margin-bottom: 16px; overflow: hidden; box-shadow: 0 1px 3px rgba(79,70,229,0.05);
}
body:not(.pt-mode) details.epe-book-drawer { border-color: #99f6e4; }
summary.epe-drawer-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 11px 18px; background: linear-gradient(90deg, #eef2ff, #f8fafc);
    color: #312e81; font-size: 0.92em; font-weight: 700; cursor: pointer;
    list-style: none; user-select: none;
}
body:not(.pt-mode) summary.epe-drawer-bar {
    background: linear-gradient(90deg, #f0fdfa, #f8fafc); color: #115e59;
}
summary.epe-drawer-bar::-webkit-details-marker { display: none; }
.epe-drawer-grid {
    display: grid; grid-template-columns: 1fr 1.2fr; gap: 16px;
    padding: 16px 20px; border-top: 1px solid #e0e7ff; background: #fcfcff;
    font-size: 0.88em; line-height: 1.65; color: #334155;
}
@media (max-width: 860px) { .epe-drawer-grid { grid-template-columns: 1fr; } }
.epe-box-card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 15px;
}
.epe-box-title {
    font-size: 0.82em; font-weight: 800; color: var(--primary);
    text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 6px;
    display: flex; align-items: center; gap: 6px;
}
.epe-contrast-list { margin: 6px 0 0 0; padding-left: 18px; }
.epe-contrast-list li { margin-bottom: 6px; }
.epe-quote-chip {
    margin-top: 8px; padding: 7px 10px; background: #f8fafc;
    border-left: 3px solid var(--primary); font-size: 0.92em; color: #475569; border-radius: 0 6px 6px 0;
}

/* EPE 认知图式导读框 */
.epe-explain-box {
    background: var(--primary-light);
    border-left: 4px solid var(--primary);
    padding: 12px 20px; font-size: 0.9em; line-height: 1.65;
    color: #1e293b; border-bottom: 1px solid #e2e8f0;
}

/* 词条表格与无下划线排版 */
table { width: 100%; border-collapse: collapse; background: #fff; table-layout: fixed; }
th {
    background: #f8fafc; font-weight: 700; font-size: 0.82em; color: #475569;
    padding: 11px 16px; border-bottom: 2px solid #e2e8f0; text-align: left;
}
td { padding: 14px 16px; text-align: left; border-bottom: 1px solid #f1f5f9; vertical-align: top; }
tr:hover { background: #fcfcfd; }

.word-line { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; margin-bottom: 6px; }
.word { font-size: 1.16em; font-weight: 800; color: #0f172a; letter-spacing: -0.01em; }
.pt-highlight { color: var(--primary); font-weight: 800; text-decoration: none; }
.sense-badge {
    font-size: 0.7em; font-weight: 700; padding: 1px 6px; border-radius: 4px;
    background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0;
}
.badge-stack { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; margin-top: 4px; }

.sep-Separable { display: inline-block; padding: 2px 8px; font-size: 0.72em; font-weight: 600; border-radius: 5px; background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
.sep-Inseparable { display: inline-block; padding: 2px 8px; font-size: 0.72em; font-weight: 600; border-radius: 5px; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
.sep-Intransitive { display: inline-block; padding: 2px 8px; font-size: 0.72em; font-weight: 600; border-radius: 5px; background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; }

.reg-Formal { display: inline-block; padding: 2px 8px; font-size: 0.72em; font-weight: 600; border-radius: 5px; background: #f5f3ff; color: #6d28d9; border: 1px solid #ddd6fe; }
.reg-Neutral { display: inline-block; padding: 2px 8px; font-size: 0.72em; font-weight: 600; border-radius: 5px; background: #f8fafc; color: #475569; border: 1px solid #e2e8f0; }
.reg-Informal { display: inline-block; padding: 2px 8px; font-size: 0.72em; font-weight: 600; border-radius: 5px; background: #fefce8; color: #a16207; border: 1px solid #fef08a; }
.reg-Slang { display: inline-block; padding: 2px 8px; font-size: 0.72em; font-weight: 600; border-radius: 5px; background: #fff1f2; color: #be123c; border: 1px solid #fecdd3; }

.cn-precise { font-size: 1.02em; font-weight: 700; color: #0f172a; line-height: 1.45; display: block; margin-bottom: 6px; }
.def-en-sub { font-size: 0.84em; color: #64748b; line-height: 1.45; }
.eq-verb {
    display: inline-block; font-size: 0.9em; font-weight: 700; color: #4338ca;
    background: #eef2ff; padding: 4px 10px; border-radius: 6px; border: 1px solid #c7d2fe;
}

/* 3 组双语例句的清爽无下划线卡片 */
.ex-list { display: flex; flex-direction: column; gap: 7px; }
.ex-item {
    background: #f8fafc; border-left: 3px solid #cbd5e1; padding: 6px 12px;
    border-radius: 0 6px 6px 0; transition: border-color 0.15s;
}
tr:hover .ex-item { border-left-color: var(--primary); }
.ex-num { font-weight: 700; color: var(--primary); margin-right: 5px; font-style: normal; }
.ex-en { color: #1e293b; font-size: 0.9em; line-height: 1.45; }
.ex-en b { color: var(--primary); font-weight: 700; text-decoration: none; }
.orig-word { color: #64748b; border-bottom: 1px dashed #94a3b8; font-weight: 600; }
.swap-pv-tag {
    display: inline-block; background: var(--primary-light); color: var(--primary);
    border: 1px solid var(--primary-border); padding: 0px 6px; border-radius: 4px;
    font-size: 0.88em; font-weight: 600; margin: 0 2px;
}
.swap-tag {
    display: inline-block; background: #f1f5f9; color: #475569;
    border: 1px solid #e2e8f0; padding: 0px 6px; border-radius: 4px;
    font-size: 0.85em; font-weight: 600; margin: 0 2px;
}
.ex-zh { color: #64748b; font-size: 0.84em; margin-top: 2px; line-height: 1.4; padding-left: 18px; }
</style>

<script>
let currentSep = "all";
let currentReg = "all";
let currentQuery = "";

function toggleAllSections(expand) {
    document.querySelectorAll("details.sub-section").forEach(d => d.open = expand);
}

function jumpToSection(secId) {
    const el = document.getElementById(secId);
    if (el) { el.open = true; el.scrollIntoView({ behavior: "smooth", block: "start" }); }
}

function applyDualFilter() {
    const q = currentQuery.trim().toLowerCase();
    document.querySelectorAll("tr[data-sep]").forEach(row => {
        const matchSep = (currentSep === "all" || row.dataset.sep === currentSep);
        const matchReg = (currentReg === "all" || row.dataset.reg === currentReg);
        const matchQ = (!q || row.innerText.toLowerCase().includes(q));
        row.style.display = (matchSep && matchReg && matchQ) ? "" : "none";
    });
}

function filterSeparability(sepType, btn) {
    currentSep = sepType;
    if (btn) {
        btn.parentElement.querySelectorAll(".seg-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
    }
    applyDualFilter();
}

function filterRegister(regType, btn) {
    currentReg = regType;
    if (btn) {
        btn.parentElement.querySelectorAll(".seg-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
    }
    applyDualFilter();
}

function filterSearch(val) {
    currentQuery = val;
    toggleAllSections(true);
    applyDualFilter();
}
</script>

<script id="clean-underscore-script">
document.addEventListener("DOMContentLoaded", function() {
  document.querySelectorAll("h1, h2, h3, nav a, .unified-nav-bar a, .nav-btn, .tab-btn, .category-btn, summary, .card-title").forEach(el => {
    el.childNodes.forEach(node => {
      if (node.nodeType === Node.TEXT_NODE && node.nodeValue.includes("_")) {
        node.nodeValue = node.nodeValue.replace(/\b(?:sc_|pt_)?(\d{2})_+/g, "$1 ").replace(/_/g, " ");
      }
    });
  });
});
</script>

