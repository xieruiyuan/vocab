<tr data-sep='Intransitive'><td class='word'>hold <span class='pt-highlight'>back</span><span class='sense-badge' title='该短语共有 6 个核心义项'>义项 6/6</span><div><span class='sep-Intransitive'>🟠 不及物/不拆分 (Intransitive)</span></div></td><td><span class='cn-precise'>抑制</span></td><td><span class='eq-verb'>forbear, refrain</span></td><td class='def-en'><b>Meaning:</b> refrain from doing<div class='ex-sent'>“she forbore a snicker”</div></td></tr>
<tr data-sep='Separable'><td class='word'>push <span class='pt-highlight'>back</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>向后推</span></td><td><span class='eq-verb'>repel, drive</span></td><td class='def-en'><b>Meaning:</b> cause to move back by force or influence<div class='ex-sent'>“repel the enemy”</div></td></tr>
<tr data-sep='Separable'><td class='word'>trim <span class='pt-highlight'>back</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>减少</span></td><td><span class='eq-verb'>reduce, trim</span></td><td class='def-en'><b>Meaning:</b> cut down on; make a reduction in<div class='ex-sent'>“reduce your daily fat intake”</div></td></tr>
<tr data-sep='Separable'><td class='word'>choke <span class='pt-highlight'>back</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>抑制</span></td><td><span class='eq-verb'>suppress, inhibit</span></td><td class='def-en'><b>Meaning:</b> suppress<div class='ex-sent'>“He choked down his rage”</div></td></tr>
</table></details>
</body></html>