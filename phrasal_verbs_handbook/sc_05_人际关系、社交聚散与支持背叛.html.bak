<style>
:root {
    --primary: #0d9488;
    --primary-light: #f0fdfa;
    --primary-border: #ccfbf1;
}
body.pt-mode {
    --primary: #4f46e5;
    --primary-light: #eef2ff;
    --primary-border: #e0e7ff;
}

/* 顶部模式切换栏 */
.mode-switch-bar {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    background: #0f172a; padding: 10px 18px; border-radius: 12px; margin-bottom: 12px;
    color: #fff; flex-wrap: wrap; box-shadow: 0 2px 8px rgba(15,23,42,0.08);
}
.mode-group { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.mode-btn {
    text-decoration: none; padding: 7px 14px; border-radius: 8px; font-size: 0.86em;
    font-weight: 600; color: #cbd5e1; background: rgba(255,255,255,0.08); transition: all 0.15s;
}
.mode-btn:hover { background: rgba(255,255,255,0.16); color: #fff; }
.mode-btn.active-sc { background: #0d9488; color: #fff; }
.mode-btn.active-pt { background: #4f46e5; color: #fff; }

/* 极简 1 行式顶部导航栏 */
