.arrow-icon { display: inline-block; transition: transform 0.2s ease; margin-right: 10px; font-size: 0.82em; color: #94a3b8; }
details[open] > summary.sub-header .arrow-icon { transform: rotate(90deg); color: #38bdf8; }
.sub-meta { font-size: 0.8em; font-weight: 600; color: #e2e8f0; background: rgba(255,255,255,0.12); padding: 3px 10px; border-radius: 99px; }


/* EPE 原著章节精要折叠抽屉（保持首屏简洁，展开即读原书精髓） */
details.epe-book-drawer {
