    margin-bottom: 16px; overflow: hidden; box-shadow: 0 1px 3px rgba(79,70,229,0.05);
}
body:not(.pt-mode) details.epe-book-drawer { border-color: #99f6e4; }
summary.epe-drawer-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 11px 18px; background: linear-gradient(90deg, #eef2ff, #f8fafc);
