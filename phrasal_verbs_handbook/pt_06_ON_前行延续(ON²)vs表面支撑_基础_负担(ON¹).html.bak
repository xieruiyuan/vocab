<tr data-sep='Separable' data-reg='Neutral'><td><div class='word-line'><span class='word'>lean <span class='pt-highlight'>on</span></span></div><div class='badge-stack'><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span><span class='reg-Neutral' title='🤖 自动判定依据：语料库日常/小说会话分布活跃' style='cursor:help;'>⚖️ 通用/中性 (Neutral)</span></div></td><td><span class='cn-precise' style='font-weight:600;color:#1e293b;'>rest on for support</span></td><td><span class='eq-verb'>touch, adjoin</span></td><td><div class='ex-list'><div class='ex-item'><div class='ex-en'><span class='ex-num'>📌</span>You can <b>lean</b> <b>on</b> me if you get tired.</div></div></div></td></tr>
<tr data-sep='Separable' data-reg='Neutral'><td><div class='word-line'><span class='word'>rely <span class='pt-highlight'>on</span></span><span class='sense-badge' title='该短语共有 2 个核心义项'>1/2</span></div><div class='badge-stack'><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span><span class='reg-Neutral' title='🤖 自动判定依据：语料库学术/公文分布比高 (1.722x)' style='cursor:help;'>⚖️ 通用/中性 (Neutral)</span></div></td><td><span class='cn-precise' style='font-weight:600;color:#1e293b;'>be dependent on, as for support or maintenance</span></td><td><span class='eq-verb'>be</span></td><td><div class='ex-list'><div class='ex-item'><div class='ex-en'><span class='ex-num'>📌</span>Elderly parents often depend on their adult children.</div></div></div></td></tr>
