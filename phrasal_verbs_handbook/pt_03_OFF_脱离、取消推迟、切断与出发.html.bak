<tr data-sep='Intransitive'><td class='word'>slack <span class='pt-highlight'>off</span><div><span class='sep-Intransitive'>🟠 不及物/不拆分 (Intransitive)</span></div></td><td><span class='cn-precise'>松懈</span></td><td><span class='eq-verb'>abate, slack</span></td><td class='def-en'><b>Meaning:</b> become less in amount or intensity<div class='ex-sent'>“The storm abated”</div></td></tr>
<tr data-sep='Separable'><td class='word'>partition <span class='pt-highlight'>off</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>分隔成，隔开</span></td><td><span class='eq-verb'>partition, separate</span></td><td class='def-en'><b>Meaning:</b> divide into parts, pieces, or sections<div class='ex-sent'>“The Arab peninsula was partitioned by the British”</div></td></tr>
<tr data-sep='Separable'><td class='word'>reel <span class='pt-highlight'>off</span><span class='sense-badge' title='该短语共有 2 个核心义项'>义项 1/2</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>背诵，朗读，叙述</span></td><td><span class='eq-verb'>recite</span></td><td class='def-en'><b>Meaning:</b> recite volubly or extravagantly<div class='ex-sent'>“He could recite the names of all the chemical elements”</div></td></tr>
<tr data-sep='Separable'><td class='word'>reel <span class='pt-highlight'>off</span><span class='sense-badge' title='该短语共有 2 个核心义项'>义项 2/2</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>退卷，退绕，卷...于轴上</span></td><td><span class='eq-verb'>unreel, reel</span></td><td class='def-en'><b>Meaning:</b> unwind from or as if from a reel<div class='ex-sent'>“unreel the tape”</div></td></tr>
<tr data-sep='Intransitive'><td class='word'>beetle <span class='pt-highlight'>off</span><div><span class='sep-Intransitive'>🟠 不及物/不拆分 (Intransitive)</span></div></td><td><span class='cn-precise'>离开</span></td><td><span class='eq-verb'>bolt, leave</span></td><td class='def-en'><b>Meaning:</b> leave suddenly and as if in a hurry<div class='ex-sent'>“The listeners bolted when he discussed his strange ideas”</div></td></tr>
<tr data-sep='Separable'><td class='word'>hive <span class='pt-highlight'>off</span><span class='sense-badge' title='该短语共有 2 个核心义项'>义项 1/2</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>转移，使欢娱，撤回</span></td><td><span class='eq-verb'>divert, withdraw</span></td><td class='def-en'><b>Meaning:</b> withdraw (money) and move into a different location, often secretly and with dishonest intentions<div class='ex-sent'>“They decided to hive off (withdraw (money) and move into a different location, often secretly and with dishonest intentions).”</div></td></tr>
<tr data-sep='Separable'><td class='word'>hive <span class='pt-highlight'>off</span><span class='sense-badge' title='该短语共有 2 个核心义项'>义项 2/2</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>分群</span></td><td><span class='eq-verb'>discriminate, separate</span></td><td class='def-en'><b>Meaning:</b> remove from a group and make separate<div class='ex-sent'>“The unit was hived off from its parent company”</div></td></tr>
<tr data-sep='Separable'><td class='word'>rinse <span class='pt-highlight'>off</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>以清水冲洗，漱，漂清</span></td><td><span class='eq-verb'>rinse, wash</span></td><td class='def-en'><b>Meaning:</b> wash off soap or remaining dirt<div class='ex-sent'>“They decided to rinse off (wash off soap or remaining dirt).”</div></td></tr>
<tr data-sep='Intransitive'><td class='word'>bunk <span class='pt-highlight'>off</span><div><span class='sep-Intransitive'>🟠 不及物/不拆分 (Intransitive)</span></div></td><td><span class='cn-precise'>切，割，减少</span></td><td><span class='eq-verb'>cut, skip</span></td><td class='def-en'><b>Meaning:</b> play truant from work or school<div class='ex-sent'>“The boy often plays hooky”</div></td></tr>
<tr data-sep='Separable'><td class='word'>rake <span class='pt-highlight'>off</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>得到，增进，赚到</span></td><td><span class='eq-verb'>gain, clear</span></td><td class='def-en'><b>Meaning:</b> take money from an illegal transaction<div class='ex-sent'>“They decided to rake off (take money from an illegal transaction).”</div></td></tr>
<tr data-sep='Separable'><td class='word'>shrug <span class='pt-highlight'>off</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>耸肩表示蔑视</span></td><td><span class='eq-verb'>dismiss, disregard</span></td><td class='def-en'><b>Meaning:</b> minimize the importance of, brush aside<div class='ex-sent'>“Jane shrugged off the news that her stock had fallen 3 points”</div></td></tr>
<tr data-sep='Separable'><td class='word'>rattle <span class='pt-highlight'>off</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>急促背诵地</span></td><td><span class='eq-verb'>recite</span></td><td class='def-en'><b>Meaning:</b> recite volubly or extravagantly<div class='ex-sent'>“He could recite the names of all the chemical elements”</div></td></tr>
<tr data-sep='Separable'><td class='word'>fling <span class='pt-highlight'>off</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>书写，著述，写</span></td><td><span class='eq-verb'>write, compose</span></td><td class='def-en'><b>Meaning:</b> write quickly<div class='ex-sent'>“She dashed off a note to her husband saying she would not be home for supper”</div></td></tr>
<tr data-sep='Separable'><td class='word'>nip <span class='pt-highlight'>off</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>掐断，剪断</span></td><td><span class='eq-verb'>nip, clip</span></td><td class='def-en'><b>Meaning:</b> sever or remove by pinching or snipping<div class='ex-sent'>“nip off the flowers”</div></td></tr>
<tr data-sep='Separable'><td class='word'>skim <span class='pt-highlight'>off</span><span class='sense-badge' title='该短语共有 2 个核心义项'>义项 1/2</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>把…撇去，<非正>提取精华</span></td><td><span class='eq-verb'>skim, cream</span></td><td class='def-en'><b>Meaning:</b> remove from the surface<div class='ex-sent'>“skim cream from the surface of milk”</div></td></tr>
<tr data-sep='Separable'><td class='word'>fend <span class='pt-highlight'>off</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>排除，防止，禁止</span></td><td><span class='eq-verb'>debar, forefend</span></td><td class='def-en'><b>Meaning:</b> prevent the occurrence of; prevent from happening<div class='ex-sent'>“Let's avoid a confrontation”</div></td></tr>
<tr data-sep='Intransitive'><td class='word'>flake <span class='pt-highlight'>off</span><div><span class='sep-Intransitive'>🟠 不及物/不拆分 (Intransitive)</span></div></td><td><span class='cn-precise'>剥落</span></td><td><span class='eq-verb'>peel, flake</span></td><td class='def-en'><b>Meaning:</b> come off in flakes or thin small pieces<div class='ex-sent'>“The paint in my house is peeling off”</div></td></tr>
<tr data-sep='Separable'><td class='word'>raffle <span class='pt-highlight'>off</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>抽彩出售</span></td><td><span class='eq-verb'>raffle, gift</span></td><td class='def-en'><b>Meaning:</b> dispose of in a lottery<div class='ex-sent'>“We raffled off a trip to the Bahamas”</div></td></tr>
<tr data-sep='Separable'><td class='word'>skim <span class='pt-highlight'>off</span><span class='sense-badge' title='该短语共有 2 个核心义项'>义项 2/2</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>选择，宁愿，欲</span></td><td><span class='eq-verb'>choose, select</span></td><td class='def-en'><b>Meaning:</b> pick the best<div class='ex-sent'>“They decided to skim off (pick the best).”</div></td></tr>
<tr data-sep='Separable'><td class='word'>cordon <span class='pt-highlight'>off</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>围绕，圈起，放入封套</span></td><td><span class='eq-verb'>enclose, inclose</span></td><td class='def-en'><b>Meaning:</b> divide by means of a rope<div class='ex-sent'>“The police roped off the area where the crime occurred”</div></td></tr>
<tr data-sep='Separable'><td class='word'>whisk <span class='pt-highlight'>off</span><span class='sense-badge' title='该短语共有 2 个核心义项'>义项 1/2</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>取走，离去，很快地</span></td><td><span class='eq-verb'>take away</span></td><td class='def-en'><b>Meaning:</b> take away quickly and suddenly<div class='ex-sent'>“They decided to whisk off (take away quickly and suddenly).”</div></td></tr>
<tr data-sep='Separable'><td class='word'>whisk <span class='pt-highlight'>off</span><span class='sense-badge' title='该短语共有 2 个核心义项'>义项 2/2</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>拂拭</span></td><td><span class='eq-verb'>whisk, wipe</span></td><td class='def-en'><b>Meaning:</b> brush or wipe off lightly<div class='ex-sent'>“They decided to whisk off (brush or wipe off lightly).”</div></td></tr>
