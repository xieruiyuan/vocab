}
.nav-link:hover { background: #f1f5f9; color: #0f172a; border-color: #cbd5e1; }
.nav-link.active {
    background: var(--primary); color: #fff; border-color: var(--primary);
}
.nav-cnt { font-size: 0.84em; opacity: 0.8; font-weight: 500; margin-left: 2px; }

/* 清爽页面主标题区 */
.page-hero {
