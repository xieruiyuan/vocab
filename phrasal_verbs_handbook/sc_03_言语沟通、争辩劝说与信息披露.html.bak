}

/* 结构化工具栏：分段筛选器 + 实时搜索 + 章节直达 */
.toolbar-card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px;
    margin-bottom: 20px; display: flex; flex-direction: column; gap: 12px;
}
