}
.index-card:hover {
    transform: translateY(-3px); box-shadow: 0 10px 25px rgba(15,23,42,0.08); border-color: #cbd5e1;
}
.pt-theme:hover { border-color: #6366f1; }
.sc-theme:hover { border-color: #0d9488; }

.card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
.card-badge {
