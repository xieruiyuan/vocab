    border: 1px solid #e2e8f0; padding: 2px 7px; border-radius: 5px;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Inter", "SF Pro Text", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    max-width: 1340px; margin: 0 auto; padding: 20px 24px; background: #f1f5f9; color: #1e293b;
    scroll-behavior: smooth; -webkit-font-smoothing: antialiased;
}
