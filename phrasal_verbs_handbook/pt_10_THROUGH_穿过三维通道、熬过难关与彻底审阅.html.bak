.index-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 18px; margin-bottom: 36px; }

.index-card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 20px 22px;
