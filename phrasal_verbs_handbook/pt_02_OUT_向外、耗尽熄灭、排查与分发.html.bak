<tr data-sep='Separable'><td class='word'>wash <span class='pt-highlight'>out</span><span class='sense-badge' title='该短语共有 5 个核心义项'>义项 1/5</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>洗净，被洗去，洗得退色</span></td><td><span class='eq-verb'>wash, launder</span></td><td class='def-en'><b>Meaning:</b> wash free from unwanted substances, such as dirt<div class='ex-sent'>“Wash out your dirty shirt in the sink”</div></td></tr>
<tr data-sep='Separable'><td class='word'>wash <span class='pt-highlight'>out</span><span class='sense-badge' title='该短语共有 5 个核心义项'>义项 2/5</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>预防，防止，阻止</span></td><td><span class='eq-verb'>prevent, interrupt</span></td><td class='def-en'><b>Meaning:</b> prevent or interrupt due to rain<div class='ex-sent'>“The storm had washed out the game”</div></td></tr>
<tr data-sep='Separable'><td class='word'>stretch <span class='pt-highlight'>out</span><span class='sense-badge' title='该短语共有 4 个核心义项'>义项 1/4</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>伸手，开始大踏步走</span></td><td><span class='eq-verb'>unfold, stretch</span></td><td class='def-en'><b>Meaning:</b> extend or stretch out to a greater or the full length<div class='ex-sent'>“Unfold the newspaper”</div></td></tr>
<tr data-sep='Intransitive'><td class='word'>wash <span class='pt-highlight'>out</span><span class='sense-badge' title='该短语共有 5 个核心义项'>义项 3/5</span><div><span class='sep-Intransitive'>🟠 不及物/不拆分 (Intransitive)</span></div></td><td><span class='cn-precise'>被洗去，洗得退色</span></td><td><span class='eq-verb'>discolor, lose</span></td><td class='def-en'><b>Meaning:</b> lose color in the process of being washed<div class='ex-sent'>“The expensive shirt washed out in the German washing machine”</div></td></tr>
<tr data-sep='Separable'><td class='word'>wash <span class='pt-highlight'>out</span><span class='sense-badge' title='该短语共有 5 个核心义项'>义项 5/5</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>破坏，毁坏，消灭</span></td><td><span class='eq-verb'>destroy, ruin</span></td><td class='def-en'><b>Meaning:</b> wear or destroy by the force of water<div class='ex-sent'>“The hail storms had washed out the bridges”</div></td></tr>
<tr data-sep='Separable'><td class='word'>stretch <span class='pt-highlight'>out</span><span class='sense-badge' title='该短语共有 4 个核心义项'>义项 2/4</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>伸手，开始大踏步走</span></td><td><span class='eq-verb'>exsert, extend</span></td><td class='def-en'><b>Meaning:</b> thrust or extend out<div class='ex-sent'>“He held out his hand”</div></td></tr>
<tr data-sep='Intransitive'><td class='word'>stretch <span class='pt-highlight'>out</span><span class='sense-badge' title='该短语共有 4 个核心义项'>义项 3/4</span><div><span class='sep-Intransitive'>🟠 不及物/不拆分 (Intransitive)</span></div></td><td><span class='cn-precise'>伸手，开始大踏步走</span></td><td><span class='eq-verb'>stretch, lie</span></td><td class='def-en'><b>Meaning:</b> lie down comfortably<div class='ex-sent'>“To enjoy the picnic, we stretched out on the grass”</div></td></tr>
<tr data-sep='Intransitive'><td class='word'>spin <span class='pt-highlight'>out</span><div><span class='sep-Intransitive'>🟠 不及物/不拆分 (Intransitive)</span></div></td><td><span class='cn-precise'>拖延</span></td><td><span class='eq-verb'>spin, prolong</span></td><td class='def-en'><b>Meaning:</b> prolong or extend<div class='ex-sent'>“spin out a visit”</div></td></tr>
<tr data-sep='Intransitive'><td class='word'>drag <span class='pt-highlight'>out</span><span class='sense-badge' title='该短语共有 2 个核心义项'>义项 1/2</span><div><span class='sep-Intransitive'>🟠 不及物/不拆分 (Intransitive)</span></div></td><td><span class='cn-precise'>持续，支持，维持</span></td><td><span class='eq-verb'>last, endure</span></td><td class='def-en'><b>Meaning:</b> last unnecessarily long<div class='ex-sent'>“They decided to drag out (last unnecessarily long).”</div></td></tr>
<tr data-sep='Separable'><td class='word'>stretch <span class='pt-highlight'>out</span><span class='sense-badge' title='该短语共有 4 个核心义项'>义项 4/4</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>伸手，开始大踏步走</span></td><td><span class='eq-verb'>crane, stretch</span></td><td class='def-en'><b>Meaning:</b> stretch (the neck) so as to see better<div class='ex-sent'>“The women craned their necks to see the President drive by”</div></td></tr>
<tr data-sep='Separable'><td class='word'>brave <span class='pt-highlight'>out</span><div><span class='sep-Separable'>🟢 可拆分 (v. + O + adv.)</span></div></td><td><span class='cn-precise'>使受风吹雨打，侵蚀，使风化</span></td><td><span class='eq-verb'>weather, endure</span></td><td class='def-en'><b>Meaning:</b> face and withstand with courage<div class='ex-sent'>“She braved the elements”</div></td></tr>
<tr data-sep='Intransitive'><td class='word'>drag <span class='pt-highlight'>out</span><span class='sense-badge' title='该短语共有 2 个核心义项'>义项 2/2</span><div><span class='sep-Intransitive'>🟠 不及物/不拆分 (Intransitive)</span></div></td><td><span class='cn-precise'>拖延</span></td><td><span class='eq-verb'>drag, proceed</span></td><td class='def-en'><b>Meaning:</b> proceed for an extended period of time<div class='ex-sent'>“The speech dragged on for two hours”</div></td></tr>
