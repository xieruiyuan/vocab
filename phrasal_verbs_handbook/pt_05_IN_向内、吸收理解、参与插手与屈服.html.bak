<script>
const audioPlayer = new Audio();

function playPhrase(text) {
    const clean = encodeURIComponent(text.trim());
    audioPlayer.src = `https://dict.youdao.com/dictvoice?audio=${clean}&type=2`;
    audioPlayer.play().catch(() => {
        if ("speechSynthesis" in window) {
            window.speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance(text);
            u.lang = "en-US"; u.rate = 0.92;
            window.speechSynthesis.speak(u);
        }
    });
}

function toggleAllSections(expand) {
    document.querySelectorAll("details.sub-section").forEach(d => d.open = expand);
}

function jumpToSection(secId) {
    const el = document.getElementById(secId);
    if (el) { el.open = true; el.scrollIntoView({ behavior: "smooth", block: "start" }); }
}

function filterSeparability(sepType) {
    document.querySelectorAll("tr[data-sep]").forEach(row => {
        row.style.display = (sepType === "all" || row.dataset.sep === sepType) ? "" : "none";
    });
}
</script>

<script id="clean-underscore-script">
document.addEventListener("DOMContentLoaded", function() {
  document.querySelectorAll("h1, h2, h3, nav a, .unified-nav-bar a, .nav-btn, .tab-btn, .category-btn, summary, .card-title").forEach(el => {
    el.childNodes.forEach(node => {
      if (node.nodeType === Node.TEXT_NODE && node.nodeValue.includes("_")) {
        node.nodeValue = node.nodeValue.replace(/\b(?:sc_|pt_)?(\d{2})_+/g, "$1 ").replace(/_/g, " ");
      }
    });
  });
});
</script>

