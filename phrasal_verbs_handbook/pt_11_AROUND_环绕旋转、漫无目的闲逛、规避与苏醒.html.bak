}
.swap-tag {
    display: inline-block; background: #f1f5f9; color: #475569;
    border: 1px solid #e2e8f0; padding: 0px 6px; border-radius: 4px;
    font-size: 0.85em; font-weight: 600; margin: 0 2px;
}
.ex-zh { color: #64748b; font-size: 0.84em; margin-top: 2px; line-height: 1.4; padding-left: 18px; }
</style>

<script>
let currentSep = "all";
let currentReg = "all";
let currentQuery = "";

function toggleAllSections(expand) {
    document.querySelectorAll("details.sub-section").forEach(d => d.open = expand);
}

function jumpToSection(secId) {
    const el = document.getElementById(secId);
    if (el) { el.open = true; el.scrollIntoView({ behavior: "smooth", block: "start" }); }
}

function applyDualFilter() {
    const q = currentQuery.trim().toLowerCase();
    document.querySelectorAll("tr[data-sep]").forEach(row => {
        const matchSep = (currentSep === "all" || row.dataset.sep === currentSep);
        const matchReg = (currentReg === "all" || row.dataset.reg === currentReg);
        const matchQ = (!q || row.innerText.toLowerCase().includes(q));
        row.style.display = (matchSep && matchReg && matchQ) ? "" : "none";
    });
}

function filterSeparability(sepType, btn) {
    currentSep = sepType;
    if (btn) {
        btn.parentElement.querySelectorAll(".seg-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
    }
    applyDualFilter();
}

function filterRegister(regType, btn) {
    currentReg = regType;
    if (btn) {
        btn.parentElement.querySelectorAll(".seg-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
    }
    applyDualFilter();
}

function filterSearch(val) {
    currentQuery = val;
    toggleAllSections(true);
    applyDualFilter();
}
</script>

<script id="clean-underscore-script">
document.addEventListener("DOMContentLoaded", function() {
  document.querySelectorAll("h1, h2, h3, nav a, .unified-nav-bar a, .nav-btn, .tab-btn, .category-btn, summary, .card-title").forEach(el => {
    el.childNodes.forEach(node => {
      if (node.nodeType === Node.TEXT_NODE && node.nodeValue.includes("_")) {
        node.nodeValue = node.nodeValue.replace(/\b(?:sc_|pt_)?(\d{2})_+/g, "$1 ").replace(/_/g, " ");
      }
    });
  });
});
</script>

