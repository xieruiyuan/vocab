<tr><td class='word'><span class='word-en-box'>favour</span><span class='word-fr-box'>la faveur<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 favour</span></span></td><td class='phonetic'><span class='ph-en-text'>/'feivә/</span><span class='ph-fr-text'>/favœʁ/</span> <button class='audio-btn' onclick="playWord('favour', 'la faveur')" title='播放发音'>🔊</button></td><td>n. 好感, 偏爱, 喜爱, 相信, 庇护, 赞同, 支持, 信赖, 善行, 恩惠, 徽章, 礼物</td><td class='def-en'>a feeling of favorable regard</td><td>4.31</td><td><div class='ctx-box'><div class='ctx-ex'>“The case highlighted the significance of favour (a feeling of favorable regard).”</div><div class='ctx-syn'><b>同义:</b> <span class='syn-tag'>favor</span></div><div class='ctx-syn'><b>上位概念:</b> approval</div></div></td></tr>
<tr><td class='word'><span class='word-en-box'>excitement</span><span class='word-fr-box'>l'excitation<span class='fr-pos-f'>n.f.</span><span class='en-sub-hint'>🇬🇧 excitement</span></span></td><td class='phonetic'><span class='ph-en-text'>/ik'saitmәnt/</span><span class='ph-fr-text'>/ɛksitasjɔ̃/</span> <button class='audio-btn' onclick="playWord('excitement', 'l\'excitation')" title='播放发音'>🔊</button></td><td>n. 刺激, 兴奋</td><td class='def-en'>the feeling of lively and cheerful joy</td><td>4.19</td><td><div class='ctx-box'><div class='ctx-ex'>“he could hardly conceal his excitement when she agreed”</div><div class='ctx-syn'><b>同义:</b> <span class='syn-tag'>exhilaration</span></div><div class='ctx-syn'><b>上位概念:</b> joy</div></div></td></tr>
<tr><td class='word'><span class='word-en-box'>preference</span><span class='word-fr-box'>le goût<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 preference</span></span></td><td class='phonetic'><span class='ph-en-text'>/'prefәrәns/</span><span class='ph-fr-text'>/gu/</span> <button class='audio-btn' onclick="playWord('preference', 'le goût')" title='播放发音'>🔊</button></td><td>n. 偏爱, 优先, 喜爱物</td><td class='def-en'>a strong liking</td><td>4.11</td><td><div class='ctx-box'><div class='ctx-ex'>“my own preference is for good literature”</div><div class='ctx-syn'><b>同义:</b> <span class='syn-tag'>penchant</span><span class='syn-tag'>predilection</span><span class='syn-tag'>taste</span></div><div class='ctx-syn'><b>上位概念:</b> liking</div></div></td></tr>
<tr><td class='word'><span class='word-en-box'>dignity</span><span class='word-fr-box'>l'amour-propre<span class='fr-pos-m'>n.m.</span><span class='en-sub-hint'>🇬🇧 dignity</span></span></td><td class='phonetic'><span class='ph-en-text'>/'digniti/</span><span class='ph-fr-text'>/amuʁ pʁɔpʁ/</span> <button class='audio-btn' onclick="playWord('dignity', 'l\'amour-propre')" title='播放发音'>🔊</button></td><td>n. 尊严, 高贵</td><td class='def-en'>the quality of being worthy of esteem or respect</td><td>4.02</td><td><div class='ctx-box'><div class='ctx-ex'>“it was beneath his dignity to cheat”</div><div class='ctx-syn'><b>同义:</b> <span class='syn-tag'>self-respect</span><span class='syn-tag'>self-regard</span><span class='syn-tag'>self-worth</span></div><div class='ctx-syn'><b>上位概念:</b> pride</div></div></td></tr>
