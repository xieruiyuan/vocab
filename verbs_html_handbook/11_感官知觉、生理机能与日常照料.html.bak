<tr data-reg='Vivid' data-pv='0'><td class='word'><span class='word-en-box'>infect<span class='reg-Vivid'>🎨 生动/叙事</span></span><span class='word-fr-box'>infecter<span class='fr-gr-badge'>v. 1er gr.</span><span class='en-sub-hint'>🇬🇧 to infect</span></span></td><td class='phonetic'><span class='ph-en-text'>/in'fekt/</span><span class='ph-fr-text'>/ɛ̃fɛkte/</span> <button class='audio-btn' onclick="playWord('infect', 'infecter')">🔊</button></td><td>vt. 传染, 感染</td><td class='def-en'>communicate a disease to</td><td>3.36</td><td><div class='ladder-box'><div>⚖️ <b>通用同义替换:</b> <span class='nt-pill'>taint</span></div><div class='ex-line'>“Your children have infected you with this head cold”</div></div></td></tr>
<tr data-reg='Formal' data-pv='0'><td class='word'><span class='word-en-box'>vaccinate<span class='reg-Formal'>🏛️ 正式/学术</span></span><span class='word-fr-box'>immuniser<span class='fr-gr-badge'>v. 1er gr.</span><span class='en-sub-hint'>🇬🇧 to vaccinate</span></span></td><td class='phonetic'><span class='ph-en-text'>/'væksineit/</span><span class='ph-fr-text'>/imynize/</span> <button class='audio-btn' onclick="playWord('vaccinate', 'immuniser')">🔊</button></td><td>v. 预防接种</td><td class='def-en'>perform vaccinations or produce immunity in by inoculation</td><td>2.73</td><td><div class='ladder-box'><div>🏛️ <b>正式/学术升级:</b> <span class='fm-pill'>immunize</span><span class='fm-pill'>immunise</span><span class='fm-pill'>inoculate</span></div><div class='ex-line'>“We vaccinate against scarlet fever”</div></div></td></tr>
