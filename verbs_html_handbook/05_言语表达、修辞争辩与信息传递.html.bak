    border: none; background: transparent; padding: 5px 14px; border-radius: 99px;
    font-size: 0.86em; font-weight: 700; color: #475569; cursor: pointer; transition: all 0.18s;
}
.lang-btn.active { background: #b45309; color: #fff; box-shadow: 0 1px 3px rgba(180,83,9,0.3); }
body.lang-fr .lang-btn.fr-btn { background: #dc2626; color: #fff; }

.word-fr-box { display: none; }
.en-sub-hint { display: block; font-size: 0.75em; font-weight: 500; color: #64748b; margin-top: 3px; }
body.lang-fr .word-en-box { display: none; }
body.lang-fr .word-fr-box { display: inline; color: #0f172a; }

/* 语域徽章：Formal(紫金)、Neutral(宝蓝)、Vivid(玫瑰红)、法语变位组(勃艮第红) */
.reg-Formal { display: inline-block; padding: 2px 6px; font-size: 0.71em; font-weight: 700; border-radius: 4px; margin-left: 6px; background: #f3e8ff; color: #6b21a8; border: 1px solid #d8b4fe; }
.reg-Neutral { display: inline-block; padding: 2px 6px; font-size: 0.71em; font-weight: 700; border-radius: 4px; margin-left: 6px; background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
.reg-Vivid { display: inline-block; padding: 2px 6px; font-size: 0.71em; font-weight: 700; border-radius: 4px; margin-left: 6px; background: #fce7f3; color: #be185d; border: 1px solid #fbcfe8; }
.fr-gr-badge { display: inline-block; padding: 2px 6px; font-size: 0.71em; font-weight: 700; border-radius: 4px; margin-left: 6px; background: #fee2e2; color: #991b1b; }

.ph-fr-text { display: none; color: #b91c1c; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
body.lang-fr .ph-en-text { display: none; }
body.lang-fr .ph-fr-text { display: inline; }

.audio-btn {
    display: inline-flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer; font-size: 1.05em;
    padding: 2px 6px; margin-left: 5px; color: #64748b; border-radius: 4px;
}
