.fm-pill { display: inline-block; background: #f3e8ff; color: #6b21a8; font-weight: 600; padding: 1px 7px; border-radius: 4px; border: 1px solid #e9d5ff; margin-right: 4px; }
.nt-pill { display: inline-block; background: #f1f5f9; color: #334155; font-weight: 600; padding: 1px 7px; border-radius: 4px; border: 1px solid #cbd5e1; margin-right: 4px; }
