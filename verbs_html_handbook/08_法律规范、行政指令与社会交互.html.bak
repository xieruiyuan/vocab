</style>

<script>
const audioPlayer = new Audio();
let currentLang = localStorage.getItem("verbs_vocab_lang") || "en";

function setLanguage(lang) {
    currentLang = lang;
    localStorage.setItem("verbs_vocab_lang", lang);
    document.body.classList.toggle("lang-fr", lang === "fr");
    document.querySelectorAll(".lang-btn").forEach(btn => {
        btn.classList.toggle("active", btn.dataset.lang === lang);
    });
}

function speakNative(text, langCode) {
    if ("speechSynthesis" in window) {
        window.speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(text);
        u.lang = langCode; u.rate = 0.92;
        window.speechSynthesis.speak(u);
    }
}

function playWord(enWord, frAudioText) {
    if (currentLang === "fr") {
        const cleanFr = frAudioText.trim() || enWord;
        audioPlayer.src = `https://dict.youdao.com/dictvoice?audio=${encodeURIComponent(cleanFr)}&le=fr`;
        audioPlayer.play().catch(() => speakNative(cleanFr, "fr-FR"));
    } else {
        audioPlayer.src = `https://dict.youdao.com/dictvoice?audio=${encodeURIComponent(enWord.trim())}&type=2`;
        audioPlayer.play().catch(() => speakNative(enWord, "en-US"));
    }
}

function toggleAllSections(expand) {
    document.querySelectorAll("details.sub-section").forEach(d => d.open = expand);
}

function jumpToSection(secId) {
    const el = document.getElementById(secId);
    if (el) { el.open = true; el.scrollIntoView({ behavior: "smooth", block: "start" }); }
}

function filterRegister(filterType) {
    document.querySelectorAll("tr[data-reg]").forEach(row => {
        if (filterType === "all") row.style.display = "";
        else if (filterType === "phrasal") row.style.display = (row.dataset.pv === "1") ? "" : "none";
        else row.style.display = (row.dataset.reg === filterType) ? "" : "none";
    });
}

window.addEventListener("DOMContentLoaded", () => setLanguage(currentLang));
</script>
